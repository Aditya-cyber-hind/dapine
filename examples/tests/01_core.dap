func double(x) = x * 2
func triple(x) = x * 3
func ppsf(p, s) = p / s
func greet(name, greeting="Hello") = concat(greeting, " ", name)

pipeline core1_basics_transform_aggregate() {
    read "houses.csv" as raw
    print raw
    stats raw

    let min_price: int = 200000
    let max_price = 600000
    let target_beds = 3
    let prefix = "HOME_"
    let emails = ["a@gmail.com", "b@yahoo.com", "c@gmail.com"]

    filter raw where price >= min_price as affordable
    filter affordable where bedrooms >= target_beds as big
    filter big where bathrooms >= 2 as nice
    filter nice where sqft > 1000 as spacious
    filter raw where price == 300000 as exact
    filter raw where price != 350000 as not_350
    filter raw where price > 400000 as expensive
    filter raw where price < 300000 as cheap
    filter raw where price >= 200000 and price <= 500000 as mid_range
    filter raw where bedrooms >= 4 or bathrooms >= 3 as luxury_filter

    sort spacious by price desc as by_price
    sort spacious by sqft asc as by_size

    limit by_price 5 as top5
    sample spacious 50% as sampled
    distinct top5 as unique_homes

    mutate unique_homes add doubled = double(price) as m1
    mutate m1 add tripled = triple(sqft) as m2
    mutate m2 add price_per_sqft = ppsf(price, sqft) as m3
    mutate m3 add luxury_score = (bedrooms * 100) + (bathrooms * 50) as m4
    mutate m4 add half = price / 2 as m5
    mutate m5 add root = sqrt(sqft) as m6
    mutate m6 add rounded = round(price_per_sqft) as m7
    mutate m7 add floored = floor(price_per_sqft) as m8
    mutate m8 add ceiled = ceil(price_per_sqft) as m9
    mutate m9 add absolute = abs(price - 400000) as m10
    mutate m10 add label = concat(prefix, bedrooms, "BR") as m11
    mutate m11 add upper_lbl = upper(label) as m12
    mutate m12 add lower_lbl = lower(label) as m13
    mutate m13 add lbl_len = length(label) as m14
    mutate m14 add trimmed = trim(label) as m15
    mutate m15 add greeting_msg = greet(label) as m16

    rename m16 bedrooms to beds, bathrooms to baths, price to cost as renamed
    select label, beds, baths, sqft, cost, price_per_sqft, luxury_score, root, rounded, upper_lbl, greeting_msg from renamed as selected

    cast selected beds as string as c1
    cast c1 cost as int as c2
    cast c2 price_per_sqft as float as c3

    group c3 by beds [
        count(label) as homes,
        sum(cost) as total_cost,
        avg(cost) as avg_cost,
        min(cost) as cheapest,
        max(cost) as priciest,
        avg(price_per_sqft) as avg_ppsf
    ] as grouped

    sort grouped by homes desc as final

    for row in final { print final }
    print final

    write final into "core1_output.json"
    write final into "core1_output.csv"
    excel write final into "core1_output.xlsx"
    report final as "Core 1 - Basics Test" into "core1_report.md"
    chart final homes by beds as bar into "core1_chart.html"
}